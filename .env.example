# Copy to .env (Inspect loads it automatically from the working directory). Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Search backend for search=tavily / controlled (replay needs no key)
TAVILY_API_KEY=
# Hugging Face token for gated datasets (e.g. GAIA)
HF_TOKEN=

INSPECT_LOG_DIR=logs
# Apptainer pulls and sandbox scratch dirs (node-local /tmp is fastest)
APPTAINER_CACHEDIR=.apptainer_cache
LABKIT_SANDBOX_TMP=/tmp
